# Copy this file to .env and fill in what you have. LLM/calendar/embeddings
# are all optional — with those unset the app falls back to mock mode (mock
# LLM, mock calendar, hashing-based mock embeddings, file-based escalation
# log) so you can demo the FAQ / Lead / Booking / Escalation flow with zero
# external AI accounts. DATABASE_URL and REDIS_URL below are NOT optional —
# the app requires a real Postgres and Redis to start (see
# app/core/database.py, state_store.py, rate_limiter.py). PostgreSQL is also
# the CRM (leads/conversations/appointments/escalations) — there is no
# separate CRM integration to configure.

# --- LLM (session 7: Anthropic for production, Ollama for free local dev) --
# Priority: ANTHROPIC_API_KEY (if set) > Ollama (if OLLAMA_BASE_URL or
# OLLAMA_MODEL is set) > MockLLM (deterministic, offline, rule-based).
# AI_LEADFLOW_LLM_PROVIDER=anthropic|ollama|mock forces one explicitly.
ANTHROPIC_API_KEY=

# Free local dev: run `ollama serve` + `ollama pull llama3.1` (or any other
# model), then set these two. Leave both unset to stay on MockLLM.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

AI_LEADFLOW_LLM_PROVIDER=ollama

# --- Database / state (Postgres + Redis) -------------------------------
# Required. PostgreSQL connection string — see app/core/database.py.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_leadflow

# Required. Redis connection string — backs conversation state
# (state_store.py) and the rate limiter (rate_limiter.py).
REDIS_URL=redis://localhost:6379/0

# --- Embeddings (session 7: ChromaDB + local MiniLM) ------------------------
# Priority: MiniLM (all-MiniLM-L6-v2 via sentence-transformers, local, free,
# no API key — default once the package is installed) > OpenAI
# text-embedding-3-small (if OPENAI_API_KEY is set and MiniLM isn't
# available) > a deterministic offline hashing-based mock embedder (no
# semantic/paraphrase matching, but fully local/testable, zero dependencies).
# AI_LEADFLOW_EMBEDDINGS_BACKEND=minilm|openai|mock forces one explicitly.
OPENAI_API_KEY=
AI_LEADFLOW_EMBEDDINGS_BACKEND=

# Directory where the Chroma vector store persists its index.
AI_LEADFLOW_CHROMA_DIR=chroma_data

# Knowledge base directory to ingest into the RAG vector store.
AI_LEADFLOW_KB_DIR=knowledge_base/clinic

# --- CORS --------------------------------------------------------------
# Comma-separated list of allowed origins for the web widget, e.g.
# https://yourdomain.com,https://staging.yourdomain.com
AI_LEADFLOW_CORS_ORIGINS=*

# --- Admin auth --------------------------------------------------------
# HTTP Basic auth, required on every /api/admin/* route (and the dashboard,
# which prompts for these). Left unset -> defaults to admin/admin so the
# dashboard still works out of the box for a local demo; GET /health's
# "admin_auth_mode" field tells you which mode you're in ("default_credentials"
# vs "configured") without needing to check env vars by hand.
# SET THESE before deploying anywhere reachable outside localhost.
AI_LEADFLOW_ADMIN_USERNAME=
AI_LEADFLOW_ADMIN_PASSWORD=

# --- Calendar (session 7: Google Calendar, service account) -----------------
# If unset, calendar_tool.py stays in mock mode (real slot generation +
# double-booking protection against our own `appointments` table, no
# external calendar). Set GOOGLE_CALENDAR_CREDENTIALS_JSON to the full
# *contents* of a Google service-account key file (not a path) to enable
# real Google Calendar availability checks + booking.
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=UTC

# --- Escalation notifications --------------------------------------------
# Escalations are always written to PostgreSQL (visible in the admin
# dashboard) regardless of the settings below. Slack is optional, additive.
SLACK_WEBHOOK_URL=
ESCALATION_LOG_PATH=escalations.log
